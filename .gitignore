/mutants.out/
/mutants.out.old/

# Rustfmt backup
**/*.bk

# Intentionally do not lock
Cargo.lock

# Artifacts
*.core
persistence-test-*.txt
*~

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env overrides
.envrc
.direnv/
