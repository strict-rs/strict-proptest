#[test]
fn foo() -> ::hello::world::strict::TestResult {
    #[derive(Debug)]
    struct FooArgs {
        x: i32,
    }
    impl ::hello::world::prelude::Arbitrary for FooArgs {
        type Parameters = ();
        type Strategy = ::hello::world::strategy::Map<
            ::hello::world::arbitrary::StrategyFor<(i32,)>,
            fn((i32,)) -> Self,
        >;
        fn arbitrary_with((): Self::Parameters) -> Self::Strategy {
            use ::hello::world::strategy::Strategy;
            ::hello::world::prelude::any::<(i32,)>().prop_map(|(x,)| Self { x })
        }
    }
    let strategy = ::hello::world::strategy::Strategy::prop_map(
        ::hello::world::prelude::any::<FooArgs>(),
        |values| ::hello::world::sugar::NamedArguments(stringify!(FooArgs), values),
    );
    ::hello::world::strict::ensure_property(
        &strategy,
        concat!(module_path!(), "::", stringify!(foo)),
        |::hello::world::sugar::NamedArguments(_, FooArgs { x })| {
            let _ = x;
            Ok(())
        },
    )
}
