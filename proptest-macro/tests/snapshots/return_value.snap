#[test]
fn return_value() -> ::proptest::test_runner::PropertyResult<
    (i32, i32),
    <Result<
        (i32, i32),
        ComparisonFailure<i32, i32>,
    > as ::proptest::test_runner::PropertyReturn>::Success,
    <Result<
        (i32, i32),
        ComparisonFailure<i32, i32>,
    > as ::proptest::test_runner::PropertyReturn>::Failure,
    ::core::convert::Infallible,
> {
    let strategy = (
        ::proptest::prelude::any::<i32>(),
        ::proptest::prelude::any::<i32>(),
    );
    let config = ::proptest::test_runner::Config {
        test_name: Some(concat!(module_path!(), "::", stringify!(return_value))),
        source_file: Some(file!()),
        ..::proptest::strict::strict_default_config()
    };
    let property = |input| {
        let evaluate = |
            (x, y): (i32, i32),
        | -> Result<(i32, i32), ComparisonFailure<i32, i32>> {
            ensure_eq(x, y, "values agree")
        };
        ::proptest::test_runner::PropertyReturn::into_result(evaluate(input))
    };
    let mut outcome = {
        ::proptest::strict::ensure_property_with_config(
            &strategy,
            concat!(module_path!(), "::", stringify!(return_value)),
            config,
            property,
        )
    };
    match &mut outcome {
        Ok(run) => run.argument_labels = &[stringify!(x), stringify!(y)],
        Err(failure) => failure.run.argument_labels = &[stringify!(x), stringify!(y)],
    }
    outcome
}
