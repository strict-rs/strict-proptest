#[test]
fn foo() -> ::proptest::test_runner::PropertyResult<
    (i32, (i32, i32), i32, Wrapper<i32>, [i32; 2], i32, Point),
    <CheckResult as ::proptest::test_runner::PropertyReturn>::Success,
    <CheckResult as ::proptest::test_runner::PropertyReturn>::Failure,
    ::core::convert::Infallible,
> {
    let strategy = (
        ::proptest::prelude::any::<i32>(),
        ::proptest::prelude::any::<(i32, i32)>(),
        ::proptest::prelude::any::<i32>(),
        ::proptest::prelude::any::<Wrapper<i32>>(),
        ::proptest::prelude::any::<[i32; 2]>(),
        ::proptest::prelude::any::<i32>(),
        ::proptest::prelude::any::<Point>(),
    );
    let config = ::proptest::test_runner::Config {
        test_name: Some(concat!(module_path!(), "::", stringify!(foo))),
        source_file: Some(file!()),
        ..::proptest::strict::strict_default_config()
    };
    let property = |input| {
        let evaluate = |
            (
                a,
                (b, c),
                d,
                Wrapper(e),
                [f,
                g,
                ],
                h,
                Point { x, y },
            ): (i32, (i32, i32), i32, Wrapper<i32>, [i32; 2], i32, Point),
        | -> CheckResult { check((a, b, c, d, e, f, g, h, x, y)) };
        ::proptest::test_runner::PropertyReturn::into_result(evaluate(input))
    };
    let mut outcome = {
        ::proptest::strict::ensure_property_with_config(
            &strategy,
            concat!(module_path!(), "::", stringify!(foo)),
            config,
            property,
        )
    };
    match &mut outcome {
        Ok(run) => {
            run.argument_labels = &[
                stringify!(a),
                stringify!((b, c)),
                stringify!(d),
                stringify!(Wrapper(e)),
                stringify!([f, g]),
                stringify!(h),
                stringify!(Point { x, y }),
            ];
        }
        Err(failure) => {
            failure.run.argument_labels = &[
                stringify!(a),
                stringify!((b, c)),
                stringify!(d),
                stringify!(Wrapper(e)),
                stringify!([f, g]),
                stringify!(h),
                stringify!(Point { x, y }),
            ];
        }
    }
    outcome
}
